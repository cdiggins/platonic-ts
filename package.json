{
  "name": "platonic-ts",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "tsx packages/check/src/main.ts",
    "dashboard": "tsx packages/dashboard/src/main.ts",
    "backlog:regen": "tsx packages/backlog/src/main.ts regen",
    "codeview": "tsx packages/codeview/src/main.ts",
    "transcripts": "tsx packages/transcripts/src/main.ts",
    "init": "tsx packages/init/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.9.0",
    "eslint-plugin-functional": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.0"
  }
}
